{
  "name": "mockweb",
  "publisher": "nanti-test",
  "version": "0.0.1",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["onView:mockweb.view"],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "mockweb", "title": "Mock Web", "icon": "media/icon.svg" }] },
    "views": { "mockweb": [{ "type": "webview", "id": "mockweb.view", "name": "Mock Web" }] }
  }
}
