// Windows resources of nanti-ui.exe. gpui loads the window icon from resource id 1; the version
// block gives Task Manager and the taskbar the product name instead of the bare file name.
1 ICON "assets/nanti.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Nanti IDE"
      VALUE "ProductName", "Nanti IDE"
      VALUE "InternalName", "nanti"
      VALUE "OriginalFilename", "nanti.exe"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
